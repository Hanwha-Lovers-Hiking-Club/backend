# 팀 공용 설정 예시. 실제 비밀키를 이 파일에 넣지 않는다.
# OPENAI_API_KEY / SUPABASE_SERVICE_ROLE_KEY / KURE_API_KEY는 사용자 환경변수에서 주입한다.
# 사용자 환경변수를 바꾼 뒤 VS Code와 서버를 다시 시작한다.
# 현재 실행 코드는 .env를 읽는다. 이 예시는 필요한 경우 .env로 복사하여 사용한다.
# OpenAI/Ollama/Anthropic을 LLM_PROVIDER로 선택한다. 다른 공급자로 바꾸면 모델 ID도 함께 바꾼다.

# Supabase SDK에 전달할 프로젝트 기본 URL. /rest/v1을 직접 붙이지 않는다.
# 루트(/) 접속 시 requested path is invalid 응답은 관리 화면이 없다는 뜻이다.
SUPABASE_URL=https://hjfgzgpbvjhxzzgfmazy.supabase.co
# 백엔드 전용 service_role/secret key. 실제 값은 사용자 환경변수에서 읽는다.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# 로컬 프론트 주소. 실제 포트가 다르면 수정하며 여러 주소는 쉼표로 구분한다.
CORS_ORIGINS=http://localhost:3000

# 승인된 OpenAI 모델 조합. 실제 API 키의 접근 권한/품질 검증은 별도다.
# OPENAI_API_KEY=
LLM_PROVIDER=openai
EXTRACT_MODEL=gpt-6.1-sol
DRAFT_MODEL=gpt-6-luna

# MVP 규칙 검증은 필수. LLM 검증을 켤 경우 아래 VERIFY_MODEL을 사용한다.
# 규칙으로 의미를 확인할 수 없는 초안은 needs_review다.
VERIFY_RULES_ENABLED=true
VERIFY_LLM_ENABLED=false
VERIFY_MODEL=gpt-6.1-sol
VERIFY_MAX_RETRIES=2
DOCUMENT_LLM_TIMEOUT_SECONDS=60
DOCUMENT_LLM_MAX_OUTPUT_TOKENS=4096
DOCUMENT_LLM_MAX_INPUT_CHARS=48000

# 팀 첨부 env의 임베딩 모델은 kure-v3. LLM 교체와 별도로 연결한다.
# https://kure.kullm.ai/ 에서 발급하며 사용자 환경변수로 주입한다.
# KURE_API_KEY=

# 명시적으로 Ollama로 바꿀 경우의 참고 설정. 자동 fallback은 없다.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# EXTRACT_MODEL=qwen3:14b
# DRAFT_MODEL=qwen3:8b
