# 복사해서 .env 만들고 실제 값 채우기: cp .env.example .env
# .env는 커밋하지 않는다(.gitignore). 환경변수를 추가하면 app/config.py도 같은 PR에서 같이 고친다.

# Supabase 대시보드 > Settings > API 에서 확인
SUPABASE_URL=
# service_role 키(새 방식에서는 secret key). anon 키를 넣으면 RLS 때문에 DB/Storage 접근이 막힌다.
# 백엔드 전용이며 프론트에 절대 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 원본 문서가 저장된 Storage 버킷 이름 (비공개 버킷)
SUPABASE_STORAGE_BUCKET=documents

# 백엔드 호출을 허용할 프론트 주소. 쉼표로 구분
CORS_ORIGINS=http://localhost:3000

# 우리 코드(app.*)의 로그 수준: DEBUG(호출 하나하나까지) / INFO(기본) / WARNING / ERROR.
# docling, httpx 같은 서드파티 로그는 항상 WARNING부터만 보인다
LOG_LEVEL=INFO

# 문서 카드 생성(Extract/Draft/Verify)과 챗봇이 같이 쓰는 OpenAI 키. platform.openai.com > API keys 에서 발급
# 실제 키는 이 파일·Git에 넣지 않고 로컬 .env 또는 사용자 환경변수로만 둔다.
OPENAI_API_KEY=

# 카드 임베딩·원문 청크 인덱싱·챗봇 질문 임베딩이 같이 쓰는 KURE 키. https://kure.kullm.ai/ 대시보드에서 발급
KURE_API_KEY=

# 챗봇이 검색한 지식카드를 독립 검증 에이전트로 교차 검증할지 여부. 끄면(false) 답변이 빨라지고 LLM 호출이 줄지만 관련 없는 카드가 섞일 수 있다
CHAT_VERIFY_ENABLED=true

# 문서 카드 생성 파이프라인 설정(app/config.py). 값은 기본값과 같으며 비밀값이 아니다.
# 자세한 설명은 app/domains/documents/pipeline/devtools/README.md 의 "환경 설정" 절 참고.
LLM_PROVIDER=openai
EXTRACT_MODEL=gpt-6.1-sol
DRAFT_MODEL=gpt-6-luna
VERIFY_MODEL=gpt-6.1-sol
VERIFY_RULES_ENABLED=true
VERIFY_LLM_ENABLED=true
VERIFY_MAX_RETRIES=2
DOCUMENT_LLM_TIMEOUT_SECONDS=60
DOCUMENT_LLM_MAX_OUTPUT_TOKENS=4096
DOCUMENT_LLM_MAX_INPUT_CHARS=48000

# 카드 임베딩용 KURE 스냅샷과 차원. 챗봇 질문·원문 청크 임베딩(pipeline/embedding.py)은
# 이 값이 아니라 그 모듈의 상수(kure-v3, 1024)를 쓴다.
EMBEDDING_MODEL=kure-v3-20261016
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=30
