# 복사해서 .env 만들고 실제 값 채우기: cp .env.example .env
# .env는 커밋하지 않는다(.gitignore). 환경변수를 추가하면 app/config.py도 같은 PR에서 같이 고친다.

# Supabase 대시보드 > Settings > API 에서 확인
SUPABASE_URL=
# service_role 키(새 방식에서는 secret key). anon 키를 넣으면 RLS 때문에 DB/Storage 접근이 막힌다.
# 백엔드 전용이며 프론트에 절대 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 원본 문서가 저장된 Storage 버킷 이름 (비공개 버킷)
SUPABASE_STORAGE_BUCKET=documents

# 백엔드 호출을 허용할 프론트 주소. 쉼표로 구분
CORS_ORIGINS=

# Document Extract/Draft. Switching providers also requires switching both model IDs.
# Local Ollama: install/start Ollama and pull these models separately.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
EXTRACT_MODEL=qwen3:14b
DRAFT_MODEL=qwen3:8b

# MVP verification: mandatory rules; optional semantic checks use VERIFY_MODEL.
# Rules alone hold non-literal/ambiguous claims for review; they do not prove paraphrases.
VERIFY_RULES_ENABLED=true
VERIFY_LLM_ENABLED=false
VERIFY_MODEL=
VERIFY_MAX_RETRIES=2

# Anthropic alternative (no automatic fallback or model download):
# LLM_PROVIDER=anthropic
# EXTRACT_MODEL=claude-sonnet-5-5
# DRAFT_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
DOCUMENT_LLM_TIMEOUT_SECONDS=60
DOCUMENT_LLM_MAX_OUTPUT_TOKENS=4096
DOCUMENT_LLM_MAX_INPUT_CHARS=48000
