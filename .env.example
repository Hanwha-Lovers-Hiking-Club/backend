# 복사해서 .env 만들고 실제 값 채우기: cp .env.example .env
# .env는 커밋하지 않는다(.gitignore). 환경변수를 추가하면 app/config.py도 같은 PR에서 같이 고친다.

# Supabase 대시보드 > Settings > API 에서 확인
SUPABASE_URL=
# service_role 키(새 방식에서는 secret key). anon 키를 넣으면 RLS 때문에 DB/Storage 접근이 막힌다.
# 백엔드 전용이며 프론트에 절대 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 원본 문서가 저장된 Storage 버킷 이름 (비공개 버킷)
SUPABASE_STORAGE_BUCKET=documents

# 백엔드 호출을 허용할 프론트 주소. 쉼표로 구분
CORS_ORIGINS=

# 우리 코드(app.*)의 로그 수준: DEBUG(호출 하나하나까지) / INFO(기본) / WARNING / ERROR.
# docling, httpx 같은 서드파티 로그는 항상 WARNING부터만 보인다
LOG_LEVEL=INFO

# extract/draft_card/verify 노드가 쓰는 LLM. platform.openai.com > API keys 에서 발급
OPENAI_API_KEY=

# embed 노드가 쓰는 임베딩 모델(kure-v3). https://kure.kullm.ai/ 로그인 후 대시보드에서 발급
KURE_API_KEY=
